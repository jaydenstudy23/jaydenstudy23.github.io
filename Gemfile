source "https://rubygems.org"

gem "github-pages", group: :jekyll_plugins
gem "webrick", "~> 1.8"

# Ruby 3.4+ removed these from default gems; Jekyll 3.9 still expects them
gem "csv"
gem "logger"
gem "base64"
gem "bigdecimal"
gem "ostruct"

# Windows has no system tzdata — required for the `timezone:` setting
gem "tzinfo", "~> 1.2"
gem "tzinfo-data"